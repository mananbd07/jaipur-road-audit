{
  "name": "jaipur-road-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "tsc --noEmit",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply jaipur-road-audit-db --local",
    "db:seed:local": "wrangler d1 execute jaipur-road-audit-db --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.7.0"
  }
}
